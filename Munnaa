
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101027">
  <meta name="description" content="Munnaa Khan's personal portfolio website.">
  <title>Munnaa Khan | Personal Portfolio</title>

  <style>
    /* ===== GLOBAL STYLES ===== */
    :root {
      --bg: #101027;
      --card: #191936;
      --text: #f7f7ff;
      --muted: #b4b4d0;
      --purple: #a855f7;
      --pink: #ff4f9a;
      --cyan: #38d9f5;
      --border: rgba(255,255,255,.1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, textarea {
      font: inherit;
    }

    .container {
      width: min(1100px, 90%);
      margin: auto;
    }

    .gradient-text {
      background: linear-gradient(90deg, var(--cyan), var(--purple), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .section {
      padding: 90px 0;
      scroll-margin-top: 80px;
    }

    .section-title {
      font-size: clamp(28px, 4vw, 40px);
      text-align: center;
      margin-bottom: 12px;
    }

    .section-subtitle {
      text-align: center;
      color: var(--muted);
      margin: 0 auto 42px;
      max-width: 620px;
    }

    .btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 30px;
      border: 1px solid transparent;
      background: linear-gradient(100deg, var(--purple), var(--pink));
      color: white;
      font-weight: bold;
      cursor: pointer;
      transition: .25s;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(168,85,247,.3);
    }

    .btn-outline {
      background: transparent;
      border-color: var(--border);
    }

    /* ===== NAVBAR ===== */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(16,16,39,.88);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 23px;
      font-weight: 800;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      color: var(--muted);
      transition: .2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--cyan);
    }

    .menu-btn {
      display: none;
      background: transparent;
      color: white;
      border: 1px solid var(--border);
      padding: 5px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 24px;
    }

    /* ===== HERO ===== */
    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 350px;
      height: 350px;
      background: var(--purple);
      filter: blur(150px);
      opacity: .2;
      top: 0;
      left: -150px;
      pointer-events: none;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      align-items: center;
      gap: 55px;
      padding: 65px 0;
    }

    .tag {
      display: inline-block;
      padding: 7px 15px;
      border: 1px solid var(--border);
      border-radius: 25px;
      color: var(--cyan);
      margin-bottom: 20px;
      font-size: 14px;
    }

    .hero h1 {
      font-size: clamp(38px, 6vw, 68px);
      line-height: 1.15;
      margin-bottom: 20px;
    }

    .hero h2 {
      font-size: clamp(19px, 3vw, 26px);
      margin-bottom: 15px;
      color: var(--muted);
    }

    .hero p {
      color: var(--muted);
      max-width: 560px;
      margin-bottom: 28px;
    }

    .hero-buttons {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .profile-wrap {
      display: flex;
      justify-content: center;
    }

    .profile-frame {
      width: min(330px, 100%);
      aspect-ratio: 1;
      border-radius: 50%;
      padding: 8px;
      background: linear-gradient(135deg, var(--cyan), var(--purple), var(--pink));
      box-shadow: 0 0 70px rgba(168,85,247,.22);
      animation: float 4s ease-in-out infinite;
    }

    .profile-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: var(--card);
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .profile-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-placeholder {
      text-align: center;
      padding: 20px;
      color: var(--muted);
    }

    .profile-placeholder span {
      display: block;
      font-size: 75px;
      line-height: 1.4;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    /* ===== ABOUT ===== */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      transition: .25s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: rgba(56,217,245,.4);
    }

    .card h3 {
      margin-bottom: 12px;
      font-size: 21px;
    }

    .card p, .card li {
      color: var(--muted);
    }

    .info-list {
      list-style: none;
    }

    .info-list li {
      padding: 7px 0;
      border-bottom: 1px solid var(--border);
    }

    .info-list li:last-child {
      border-bottom: none;
    }

    /* ===== SKILLS ===== */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .skill-card {
      text-align: center;
    }

    .skill-icon {
      width: 65px;
      height: 65px;
      display: grid;
      place-items: center;
      margin: 0 auto 15px;
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(168,85,247,.2), rgba(56,217,245,.15));
      font-size: 30px;
    }

    /* ===== EDUCATION ===== */
    .timeline {
      max-width: 750px;
      margin: auto;
      border-left: 2px solid var(--purple);
      padding-left: 28px;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 25px;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -36px;
      top: 12px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 15px var(--cyan);
    }

    .timeline-item .year {
      color: var(--cyan);
      font-size: 14px;
      margin-bottom: 6px;
    }

    /* ===== PROJECTS ===== */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .project-icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .project-card p {
      margin-bottom: 15px;
    }

    .project-label {
      display: inline-block;
      font-size: 12px;
      padding: 4px 10px;
      border-radius: 20px;
      background: rgba(168,85,247,.17);
      color: #d8b4fe;
    }

    /* ===== CONTACT ===== */
    .contact-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 25px;
    }

    .contact-item {
      padding: 12px 0;
      color: var(--muted);
      overflow-wrap: anywhere;
    }

    .contact-item strong {
      display: block;
      color: var(--text);
    }

    .contact-form {
      display: grid;
      gap: 15px;
    }

    .contact-form input,
    .contact-form textarea {
      width: 100%;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 13px 15px;
      outline: none;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
      border-color: var(--purple);
    }

    .contact-form textarea {
      resize: vertical;
      min-height: 130px;
    }

    .form-note {
      font-size: 13px;
      color: var(--muted);
    }

    /* ===== FOOTER ===== */
    footer {
      border-top: 1px solid var(--border);
      padding: 25px 0;
      text-align: center;
      color: var(--muted);
    }

    .socials {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 15px;
    }

    .socials a {
      border: 1px solid var(--border);
      padding: 7px 13px;
      border-radius: 20px;
      font-size: 14px;
    }

    .socials a:hover {
      border-color: var(--cyan);
      color: var(--cyan);
    }

    .back-top {
      position: fixed;
      bottom: 20px;
      right: 20px;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: white;
      font-size: 21px;
      cursor: pointer;
      display: none;
      z-index: 50;
    }

    .back-top.show {
      display: block;
    }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .6s ease, transform .6s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ===== RESPONSIVE DESIGN ===== */
    @media (max-width: 800px) {
      .menu-btn {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 72px;
        left: 0;
        width: 100%;
        padding: 22px 5%;
        background: #15152f;
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
      }

      .nav-links.open {
        display: flex;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 40px;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-buttons, .socials {
        justify-content: center;
      }

      .profile-wrap {
        grid-row: 1;
      }

      .profile-frame {
        width: 230px;
      }

      .about-grid, .contact-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid, .projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .section {
        padding: 65px 0;
      }
    }

    @media (max-width: 500px) {
      .skills-grid, .projects-grid {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 22px;
      }

      .hero h1 {
        font-size: 39px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation: none !important;
        transition: none !important;
      }

      .reveal {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

